# Docker image — override when building/pushing from a fork
# REGISTRY_IMAGE=ghcr.io/your-username/your-repo
# IMAGE_TAG=latest

MONGODB_URI=mongodb://localhost:27017/elo-rating
# MongoDB credentials (used by docker-compose only — not needed for local dev)
# Root admin — only used during first-time container init
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
# App-level user — least-privilege, readWrite on elo-rating db only
MONGO_APP_USER=elo
MONGO_APP_PASSWORD=changeme

PORT=3001
TIME_PER_COMPARISON=5000
QUESTION=Which image has higher visual complexity?
# Optional markdown description shown below the question on the intro screen
QUESTION_DESCRIPTION=
# Title shown in small text on the intro screen
APP_TITLE=ELO Rating
# How many images to preload in the background at startup (0 = all)
PRELOAD_COUNT=6
# ELO K-factor — how much each comparison shifts ratings (reference: 100 per python/compute_elo.py)
ELO_K_FACTOR=100
# ELO replay count — number of independent shuffle-replays for mean ELO
# (mirrors python/compute_elo.py --n_replays; higher = more stable, slightly slower per comparison)
ELO_N_REPLAYS=100
# Max pairs shown per session (0 = unlimited — show all possible pairs)
SESSION_PAIRS_LIMIT=0
# Distribution chart: number of ELO replay shuffles (higher = more stable, slower)
CHART_N_REPLAYS=50
# Distribution chart: how many images to plot (0 = all, sorted by mean ELO ascending)
CHART_IMAGE_LIMIT=0
